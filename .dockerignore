# NOTE: '**' is used to match all directories and subdirectories

# Python cache / temp files
**/__pycache__
**/*.pyc

# Readme and Dockerfiles
**/Dockerfile
**/README.md

# Test directories
**/tests

# Compiled python modules.
*.pyc

# Setuptools distribution folder.
/dist/

# Python egg metadata, regenerated from source files by setuptools.
/*.egg-info